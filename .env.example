# BISense configuration. Copy to .env and edit. Every variable is optional.
# Without any LLM key BISense still works: answers use the extractive mode (verbatim clauses).

# --- app ---------------------------------------------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# DEBUG=true enables /api/debug/trace/{id}. Never enable on a public deployment.
DEBUG=false
# DEMO_MODE=true: always try the live LLM first, fall back to answers cached by `npm run warm`.
DEMO_MODE=false

# --- data --------------------------------------------------------------------------------------
# official (default): only official sources: BIS documents (A), BIS website pages/lists (B), government
#   notifications (C). sample: also loads the synthetic Tier D pack, labelled "Sample data, not official".
DATASET=official
DATA_DIR=./data

# --- LLM (any OpenAI-compatible chat endpoint) ---------------------------------------------------
# LLM_PROVIDER: openai_compatible | none (extractive only) | fake (tests)
LLM_PROVIDER=openai_compatible
#
# Option A: Groq free tier (fast). Create a key at https://console.groq.com/keys
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b      (checked 2026-09-27; see console.groq.com/docs/models for the current list)
# Option B: Google Gemini free tier via its OpenAI-compatible endpoint. Key: https://aistudio.google.com/apikey
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
# Option C: fully offline with Ollama (https://ollama.com), e.g. `ollama pull llama3.2` (3B; runs on an 8 GB GPU)
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2   (start Ollama with OLLAMA_CONTEXT_LENGTH=8192)
#   (no API key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=1200

# --- retrieval ---------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_ENABLED=true
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ONNX_THREADS=2
TOP_K_CONTEXT=8
CONTEXT_TOKEN_BUDGET=3000
# Evidence gate and strength thresholds (cross-encoder scores). Calibrated by `npm run eval`.
GATE_RERANK_MIN=-4.0
# Stricter gate used only when no LLM is configured (no model to decline weak evidence).
GATE_RERANK_MIN_NO_LLM=1.0
STRENGTH_STRONG_MIN=3.0
STRENGTH_MODERATE_MIN=0.0

# --- languages and voice -----------------------------------------------------------------------
LANGUAGES=en,hi,kn
TRANSLATION_PROVIDER=llm
# Optional: a different model (same provider and key) for translating answers into Hindi/Kannada.
# With Groq, openai/gpt-oss-20b translated reliably in our test (2026-09-27).
TRANSLATION_MODEL=
STT_PROVIDER=browser
TTS_PROVIDER=browser
SARVAM_API_KEY=

# --- limits and security -----------------------------------------------------------------------
RATE_LIMIT_ASK=20/minute
ALLOW_UPLOADS=false
CORS_ORIGINS=http://localhost:5173
